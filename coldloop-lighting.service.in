[Unit]
Description=Coldloop lighting for NZXT Kraken Elite (pump ring and fan chain)
Documentation=file://@COLDLOOP_DIR@/VERIFIED_COMMANDS.md

# Starts at boot rather than at login; see liquidctl.service for the two halves
# that make that work (`loginctl enable-linger` plus WantedBy=default.target).

# Ordered after the HUD, which runs `liquidctl initialize all`. That is not a
# hard dependency -- lighting is perfectly useful with the HUD stopped, so
# After= without Requires= -- but when both start together it avoids writing
# LED colours into the middle of the device being initialized.
After=liquidctl.service

# Same reasoning as liquidctl.service: cap restarts so a failing holder gives up
# instead of respawning forever. These must live in [Unit]; systemd ignores them
# in [Service].
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# Same wait-and-verify as the HUD. Lighting sets no duties, so the refusal
# matters less here, but writing Hue 2 reports to an unverified cooler is still
# not worth doing for a cosmetic feature.
ExecStartPre=@COLDLOOP_DIR@/venv/bin/python @COLDLOOP_DIR@/kraken_hud.py --wait-for-device 45
TimeoutStartSec=120

# Why this is a long-running service and not a one-shot command:
#
# The Kraken's firmware does not retain per-LED state. A colour written once
# starts corrupting after 20-30 seconds -- one LED on the ring and one on the
# fan chain revert to green. Rewriting the same colour clears it, so the
# lighting has to be *held*, not set. This process rewrites it every 8 seconds.
#
# It reads ~/.config/coldloop/lighting.json, the same file Coldloop's Lighting
# tab writes, so changing the mode there is a `systemctl --user restart` away.
#
# This deliberately does NOT run `liquidctl initialize` or touch pump and fan
# duties. Cooling belongs to liquidctl.service alone; nothing about lighting
# should be able to change how hard the fans run.
ExecStart=@COLDLOOP_DIR@/venv/bin/python \
    @COLDLOOP_DIR@/coldloop_lighting.py --apply

# Leave the LEDs dark rather than holding a half-decayed colour once nothing is
# refreshing them. `-` so a failure here cannot block the stop.
ExecStopPost=-@COLDLOOP_DIR@/venv/bin/python \
    @COLDLOOP_DIR@/coldloop_lighting.py --off

Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
