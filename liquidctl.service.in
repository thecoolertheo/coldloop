[Unit]
Description=Coldloop HUD for NZXT Kraken Elite (liquidctl)
Documentation=file://@COLDLOOP_DIR@/VERIFIED_COMMANDS.md

# Starts at boot, not at login. That needs two things together, and neither
# works alone: `loginctl enable-linger theo`, so this user's systemd instance
# is started at boot instead of at first login, and WantedBy=default.target
# below, because graphical-session.target does not exist until someone logs in.
#
# Consequence worth knowing: this no longer stops at logout. The cooling
# baseline in ExecStartPre therefore applies from boot, which is the safer
# direction -- the fans are set before anyone logs in rather than after.

# A crash loop here previously combined with an unsafe hardware command to make
# the machine unusable across reboots. These caps mean systemd gives up instead
# of reapplying a bad state forever; `systemctl --user reset-failed` clears it.
# They must live in [Unit]: systemd ignores them in [Service].
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple

# Wait for the cooler, and refuse any cooler other than the verified one.
# This must stay the FIRST ExecStartPre: everything below it sets a duty.
#
# Waiting, because starting at boot races USB enumeration in a way starting at
# login never did. Failing instantly would burn the whole 5-start budget in
# under a minute and leave the unit permanently failed.
#
# Refusing, because `--match Kraken` is a description substring that selects
# any Kraken, while the pump and fan duties below were checked against one
# device only. Without this gate, installing on a different Kraken applies an
# unverified fan curve at boot, before anyone can log in and stop it.
ExecStartPre=@COLDLOOP_DIR@/venv/bin/python @COLDLOOP_DIR@/kraken_hud.py --wait-for-device 45

# Give the waits above room; the default 90s start timeout is not enough once
# a 45s device wait is followed by three liquidctl calls.
TimeoutStartSec=180

# Initialize the device, then apply a cooling baseline.
#
# Fan is set as a temperature/duty curve rather than a flat value. Every point
# is at or above 30%: the fan channel's driver minimum is 0, and
# `set fan speed 0` is accepted silently with exit status 0 while stopping the
# radiator fans. Because this unit reapplies its settings at every start, any
# unsafe value here would be reinstated on every login. Keep every duty in this
# line >= 30.
#
# Curve points are interpolated by liquidctl over 20-59 C (_CRITICAL_TEMPERATURE).
ExecStartPre=@COLDLOOP_DIR@/venv/bin/liquidctl initialize all
ExecStartPre=@COLDLOOP_DIR@/venv/bin/liquidctl --match Kraken set pump speed 75
ExecStartPre=@COLDLOOP_DIR@/venv/bin/liquidctl --match Kraken set fan speed 20 30 30 45 40 70 50 100

ExecStart=@COLDLOOP_DIR@/venv/bin/python @COLDLOOP_DIR@/kraken_hud.py

# Hand the LCD back to the firmware's native display when the HUD stops, so a
# stopped service does not leave a frozen frame on the screen.
ExecStopPost=-@COLDLOOP_DIR@/venv/bin/liquidctl --match Kraken set lcd screen liquid

Restart=on-failure
RestartSec=10

[Install]
WantedBy=default.target
