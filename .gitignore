# The virtualenv is rebuilt from requirements.txt, never committed: it is
# ~200MB of platform-specific binary wheels, and it contains liquidctl, whose
# GPL-3.0-or-later terms would attach to anything redistributing it.
venv/

__pycache__/
*.pyc

# Editor backups the suite's own script editor writes next to the originals.
*.bak

# Rendered frames and preview images are build output, not source.
*.png

# ...but screenshots for the README are source. Without this exception the
# `*.png` rule above silently swallows them and `git add` appears to do nothing.
!docs/*.png
